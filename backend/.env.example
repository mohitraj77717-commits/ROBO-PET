# ROBO PET Environment Configuration Template
# Copy this file to .env and insert your Gemini API Key

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7

# Flask Server
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*
SERVE_FRONTEND=true

# ESP32 Hardware Serial Connection
# Set to AUTO to automatically detect USB Serial, or specify (e.g. COM3 or /dev/ttyUSB0)
SERIAL_PORT=AUTO
BAUD_RATE=115200
# SIMULATE_SERIAL options: 'auto' (simulate if no ESP32 plugged in), 'true', or 'false'
SIMULATE_SERIAL=auto

# SG90 Servo Safety Limits (degrees 0-180)
SERVO_PAN_MIN=10
SERVO_PAN_MAX=170
SERVO_PAN_CENTER=90

SERVO_TILT_MIN=40
SERVO_TILT_MAX=140
SERVO_TILT_CENTER=90
